<Window x:Class="HunchesAndHerrings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hunches &amp; Herrings"
        Icon="Assets/HunchesAndHerrings.ico"
        Width="1560" Height="960" MinWidth="1280" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource InkBrush}">
    <Grid x:Name="Root">

        <!-- =================================================== Game view -->
        <Grid x:Name="GameView" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Source="Assets/HunchesAndHerrings.png" Width="58" Height="58" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CaseTitleText" FontFamily="{StaticResource TitleFont}" FontSize="28" />
                        <TextBlock x:Name="CaseSubtitleText" FontFamily="{StaticResource HandFont}" FontSize="14"
                                   Foreground="{StaticResource InkFadedBrush}" />
                        <TextBlock x:Name="CrimeText" FontFamily="{StaticResource HandFont}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource RedInkBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" FontFamily="{StaticResource HandFont}" FontSize="26" HorizontalAlignment="Center" />
                    <Grid Width="360" Height="10" Margin="0,4,0,0">
                        <Border BorderBrush="{StaticResource InkBrush}" BorderThickness="1.2" />
                        <Border x:Name="TimeFill" HorizontalAlignment="Left" Background="{StaticResource InkBrush}"
                                Opacity="0.55" Width="0" Margin="1" />
                    </Grid>
                    <TextBlock x:Name="TimeLeftText" FontFamily="{StaticResource BodyFont}" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{StaticResource InkFadedBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="DeductionText" FontFamily="{StaticResource HandFont}" FontSize="18"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button x:Name="HunchButton" Content="Hunch"
                                ToolTip="Spend Deduction for a nudge toward something important you haven't found." />
                        <Button x:Name="AccuseButton" Content="Accuse!" Foreground="{StaticResource RedInkBrush}" FontWeight="Bold"
                                ToolTip="Name the murderer, their motive and your key evidence. This ends the case." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox x:Name="MusicCheck" Content="Music" IsChecked="True" />
                        <CheckBox x:Name="SfxCheck" Content="Sound" IsChecked="True" />
                        <Button x:Name="SaveButton" Content="Save" />
                        <Button x:Name="LoadButton" Content="Load" />
                        <Button x:Name="MenuButton" Content="Title screen" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <!-- ============ Left: blueprint and log -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,3">
                            <TextBlock Text="Whereabouts at" FontFamily="{StaticResource HandFont}" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button x:Name="HourPrev" Content="◀" Padding="6,0" Margin="1" />
                            <TextBlock x:Name="HourText" FontFamily="{StaticResource HandFont}" FontSize="15" MinWidth="70"
                                       TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            <Button x:Name="HourNext" Content="▶" Padding="6,0" Margin="1" />
                            <Button x:Name="HourNow" Content="Now" Padding="6,0" Margin="1" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <RadioButton x:Name="FloorUpper" Style="{StaticResource FloorTab}" GroupName="Floors" />
                            <RadioButton x:Name="FloorGround" Style="{StaticResource FloorTab}" GroupName="Floors" IsChecked="True" />
                            <RadioButton x:Name="FloorCellar" Style="{StaticResource FloorTab}" GroupName="Floors" />
                        </StackPanel>
                    </DockPanel>

                    <Border x:Name="MapBorder" Grid.Row="1" BorderBrush="{StaticResource InkBrush}" BorderThickness="1.4" Padding="4">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="MapCanvas" Width="640" Height="432" />
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <StackPanel x:Name="MapInfoPanel" Margin="0,6,0,0" />
                        <TextBlock Text="Case log" FontFamily="{StaticResource HandFont}" FontSize="17" Margin="0,6,0,2" />
                    </StackPanel>

                    <Border Grid.Row="3" BorderBrush="{StaticResource InkFadedBrush}" BorderThickness="1" Padding="6">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="LogPanel" />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ============ Centre: the room you're in, and interviews -->
                <Border Grid.Column="1" BorderBrush="{StaticResource InkBrush}" BorderThickness="1.4" Padding="12" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="RoomTitle" FontFamily="{StaticResource HandFont}" FontSize="26" />
                            <TextBlock x:Name="RoomDescription" FontFamily="{StaticResource BodyFont}" FontSize="14"
                                       TextWrapping="Wrap" FontStyle="Italic" />
                            <TextBlock x:Name="RoomStatus" FontFamily="{StaticResource BodyFont}" FontSize="13"
                                       TextWrapping="Wrap" Foreground="{StaticResource RedInkBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                            <Button x:Name="SearchButton" Content="Search room (20 min)" />
                            <Button x:Name="WaitButton" Content="Wait (30 min)" />
                        </WrapPanel>

                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock Text="Present" FontFamily="{StaticResource HandFont}" FontSize="17" Margin="0,0,0,2" />
                            <WrapPanel x:Name="PeoplePanel" />
                        </StackPanel>

                        <Border Grid.Row="3" BorderBrush="{StaticResource InkFadedBrush}" BorderThickness="0,1,0,0"
                                Padding="0,8,0,0" Margin="0,8,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="InterviewPanel" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============ Right: journal, notebook, sergeant -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="160" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="JournalLauncher" Grid.Row="0" BorderBrush="{StaticResource InkBrush}" BorderThickness="1.4"
                            Padding="8" Margin="0,0,0,8" Cursor="Hand" Background="#14FFFFFF">
                        <DockPanel>
                            <ContentControl x:Name="JournalIconHost" DockPanel.Dock="Left" Width="46" Height="56" Margin="0,0,10,0" />
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="OpenJournalButton" Content="Open journal" />
                                <CheckBox x:Name="AutoJournalCheck" Content="Open as I write" IsChecked="True" FontSize="12" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="The Journal" FontFamily="{StaticResource HandFont}" FontSize="19" FontWeight="Bold" />
                                <TextBlock x:Name="JournalSummaryText" FontFamily="{StaticResource BodyFont}" FontSize="12"
                                           Foreground="{StaticResource InkFadedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TabControl Grid.Row="1" x:Name="Notebook">
                        <TabItem Header="Suspects">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SuspectsPanel" />
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Clashes">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ContradictionsPanel" />
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Schedule">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SchedulePanel" />
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Notes">
                            <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </TabItem>
                    </TabControl>

                    <!-- The sergeant: talk to them like a colleague -->
                    <Border x:Name="SergeantPanel" Grid.Row="2" BorderBrush="{StaticResource BlueInkBrush}" BorderThickness="1.8"
                            CornerRadius="3" Margin="0,8,0,0" Padding="8" Background="#18FFFFFF">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <ContentControl x:Name="SergeantPortraitHost" DockPanel.Dock="Left" Width="42" Height="50" Margin="0,0,8,0" />
                                <Button x:Name="ChatToggle" DockPanel.Dock="Right" Content="–" Padding="7,0" VerticalAlignment="Top"
                                        ToolTip="Fold the conversation away" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="SergeantNameText" FontFamily="{StaticResource HandFont}" FontSize="17"
                                               FontWeight="Bold" Foreground="{StaticResource BlueInkBrush}" />
                                    <TextBlock x:Name="SergeantStatusText" FontFamily="{StaticResource BodyFont}" FontSize="12"
                                               FontStyle="Italic" Foreground="{StaticResource InkFadedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel x:Name="ChatBody">
                                <ScrollViewer x:Name="ChatScroll" Height="170" VerticalScrollBarVisibility="Auto" Margin="0,6,0,4">
                                    <StackPanel x:Name="ChatPanel" />
                                </ScrollViewer>
                                <WrapPanel x:Name="ChatChips" />
                                <DockPanel Margin="0,4,0,0">
                                    <Button x:Name="ChatSend" DockPanel.Dock="Right" Content="Send" />
                                    <TextBox x:Name="ChatInput" VerticalContentAlignment="Center"
                                             ToolTip="e.g. &quot;search the library&quot;, &quot;question the cook&quot;, &quot;where is the colonel?&quot;, &quot;what next?&quot;" />
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- =================================================== Journal (open book) -->
        <Grid x:Name="JournalHost" Visibility="Collapsed" />

        <!-- =================================================== Overlay (title, briefing, accusation, verdict) -->
        <Grid x:Name="OverlayHost" Background="{StaticResource OverlayBrush}" Visibility="Collapsed">
            <Border x:Name="OverlayCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="1040" Margin="40" BorderBrush="{StaticResource InkBrush}" BorderThickness="2" Padding="28,22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="OverlayContent" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
